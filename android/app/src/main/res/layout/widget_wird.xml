<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
 <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wbg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
  <TextView android:shadowColor="#33000000" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/w_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FFFFFF" android:text="الصلاة القادمة"/>
  <TextView android:shadowColor="#33000000" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:text="الظهر" android:textStyle="bold" android:textColor="#E2C27F"/>
  <Chronometer android:shadowColor="#33000000" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:countDown="true" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
  <TextView android:shadowColor="#33000000" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFFFFF" android:text="الأذان ١١:٣٧"/>
  <TextView android:shadowColor="#33000000" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/w_hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:layout_marginTop="2dp" android:maxLines="1"/>
 </LinearLayout>
</FrameLayout>
